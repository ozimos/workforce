#!/usr/bin/env bb
(require '[babashka.process :refer [shell]]
         '[babashka.fs :as fs]
         '[clojure.string :as str]
         '[clojure.pprint :refer [pprint]])

(let [[prev-head _new-head is-branch-checkout] *command-line-args*
      null-hash "0000000000000000000000000000000000000000"]
  ;; Trigger only on fresh worktree creation
  (when (and (= prev-head null-hash) (= is-branch-checkout "1"))
    (let [current-dir (str (fs/canonicalize "."))
          wt-lines (-> (shell {:out :string} "git" "worktree" "list") :out str/split-lines)
          main-worktree (some (fn [line]
                                (let [p (first (str/split (str/trim line) #"\s+"))]
                                  (when (and (not (str/ends-with? p ".git"))
                                             (not= p current-dir)
                                             (fs/exists? (fs/file p "deps.edn")))
                                    p)))
                              wt-lines)]
      (println (str "\n==> [Git Hook / Babashka] Initializing new worktree: " current-dir))

      ;; 1. Write dynamic deps.local.edn with port 0 sentinels
      (when-not (fs/exists? "deps.local.edn")
        (let [template {:launchpad/options {:nrepl-port 0 :cider-nrepl true}
                        :jetty/port {:dev 0 :test 0 :prod 0}
                        :shadow-cljs {:http-port 0}
                        :system/auto-start true
                        :frontend/watcher {:enabled true}
                        :ssr-server {:enabled true}}]
          (spit "deps.local.edn" (with-out-str (pprint template)))
          (println "  -> Created deps.local.edn (port 0 sentinels)")))

      ;; 2. Copy config/cache files from main worktree if present
      (doseq [f [".mise.toml" "opencode.json"]]
        (when (and main-worktree (fs/exists? (fs/file main-worktree f)) (not (fs/exists? f)))
          (fs/copy (fs/file main-worktree f) f)
          (println (str "  -> Copied " f))))

      ;; 3. Copy directory caches/configs/seed from main worktree
      (doseq [dir [".clj-kondo/.cache" ".lsp" ".vscode" ".calva" ".seed"]]
        (when (and main-worktree (fs/exists? (fs/file main-worktree dir)) (not (fs/exists? dir)))
          (fs/create-dirs dir)
          (fs/copy-tree (fs/file main-worktree dir) dir)
          (println (str "  -> Copied " dir))))

      ;; 4. Install root Node dependencies
      (when (fs/exists? "pnpm-lock.yaml")
        (println "  -> Installing Root Node dependencies...")
        (shell {:continue true} "pnpm" "install" "--prefer-offline"))

      ;; 5. Install SSR Server Node dependencies
      (when (fs/exists? "ssr-server/package.json")
        (println "  -> Installing SSR Server Node dependencies...")
        (shell {:dir "ssr-server" :continue true} "npm" "install" "--prefer-offline"))

      ;; 6. Run Clojure deps prep for local components (poly/security)
      (println "  -> Preparing local component dependencies (deps prep)...")
      (shell {:continue true} "clojure" "-X:deps" "prep" ":aliases" "[:dev :test :+rama :+default :poly]")

      (println "==> [Git Hook / Babashka] Worktree setup complete!\n")

      ;; 7. Beads hook execution if available
      (when (fs/which "bd")
        (try
          (apply shell {:continue true} "bd" "hooks" "run" "post-checkout" *command-line-args*)
          (catch Exception _ nil))))))
