{:mvn/repos {"central" {:url "https://repo1.maven.org/maven2/"}
             "clojars" {:url "https://clojars.org/repo/"}
             "rpl"     {:url "https://nexus.redplanetlabs.com/repository/maven-public-releases/"}}

 :aliases
 {:dev {:extra-paths ["development/src/clojure" "development/resources" "target/classes" "bases/auth-api/test/clojure"
                      "components/frontend/src/cljs" "components/frontend/test/cljs"]
        :extra-deps {org.clojure/clojure {:mvn/version "1.12.4"}
                     hato/hato {:mvn/version "1.0.0"}
                     metosin/jsonista {:mvn/version "0.3.14"}

                     poly/schema          {:local/root "components/schema"}
                     poly/config          {:local/root "components/config"}
                     poly/rama            {:local/root "components/rama"}
                     poly/user-rama       {:local/root "components/user-rama"}
                     poly/org-rama        {:local/root "components/org-rama"}
                     poly/session-rama    {:local/root "components/session-rama"}
                     poly/revocation-rama {:local/root "components/revocation-rama"}
                     poly/token           {:local/root "components/token"}
                     poly/security        {:local/root "components/security"}
                     poly/pathom          {:local/root "components/pathom"}
                     poly/mfa             {:local/root "components/mfa"}
                     poly/webauthn        {:local/root "components/webauthn"}
                     poly/oauth           {:local/root "components/oauth"}
                     poly/saml            {:local/root "components/saml"}

                     poly/auth-api   {:local/root "bases/auth-api"}

                     ;; Dev tools
                     integrant/integrant      {:mvn/version "1.0.0"}
                     integrant/repl           {:mvn/version "0.4.0"}
                     nrepl/nrepl              {:mvn/version "1.3.0"}
                     io.github.tonsky/clj-reload {:mvn/version "1.0.0"}
                     virgil/virgil             {:mvn/version "0.5.1"}

                     ;; Frontend (shadow-cljs compilation)
                     thheller/shadow-cljs     {:mvn/version "3.4.11"}
                     com.fulcrologic/fulcro   {:mvn/version "3.9.5"}}
        ;; JNA (transitive dep, likely via Rama) calls
        ;; java.lang.System::load on Java 25+. Suppresses
        ;; restricted-method warnings for unnamed modules.
        ;; Remove when JNA ships a version using the FFM API.
        :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}

  :test {:extra-paths ["components/schema/test/clojure"
                       "components/config/test/clojure"
                       "components/rama/test/clojure"
                       "components/org-rama/test/clojure"
                       "components/session-rama/test/clojure"
                       "components/revocation-rama/test/clojure"
                       "components/token/test/clojure"
                       "components/security/test/clojure"
                       "components/pathom/test/clojure"
                       "components/mfa/test/clojure"
                       "components/webauthn/test/clojure"
                       "components/oauth/test/clojure"
                       "components/saml/test/clojure"
                       "bases/auth-api/test/clojure"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                      hato/hato {:mvn/version "1.0.0"}
                      metosin/jsonista {:mvn/version "0.3.14"}}}

  :+rama {:extra-deps {poly/user-rama {:local/root "components/user-rama"}
                       poly/org-rama {:local/root "components/org-rama"}}
          :extra-paths ["components/user-rama/test/clojure"
                        "components/org-rama/test/clojure"]}

  :+default {:extra-deps {poly/schema          {:local/root "components/schema"}
                          poly/config          {:local/root "components/config"}
                          poly/rama            {:local/root "components/rama"}
                          poly/user-rama       {:local/root "components/user-rama"}
                          poly/org-rama        {:local/root "components/org-rama"}
                          poly/session-rama    {:local/root "components/session-rama"}
                          poly/revocation-rama {:local/root "components/revocation-rama"}
                          poly/token           {:local/root "components/token"}
                          poly/security        {:local/root "components/security"}
                          poly/pathom          {:local/root "components/pathom"}
                          poly/mfa             {:local/root "components/mfa"}
                          poly/webauthn        {:local/root "components/webauthn"}
                          poly/oauth           {:local/root "components/oauth"}
                          poly/saml            {:local/root "components/saml"}
                          poly/auth-api        {:local/root "bases/auth-api"}}
             :extra-paths ["development/src/clojure" "development/resources"
                           "target/classes"
                           "components/rama/test/clojure"
                           "components/org-rama/test/clojure"
                           "components/user-rama/test/clojure"
                           "components/session-rama/test/clojure"
                           "components/revocation-rama/test/clojure"
                           "components/token/test/clojure"
                           "components/security/test/clojure"
                           "components/mfa/test/clojure"
                           "components/webauthn/test/clojure"
                           "components/oauth/test/clojure"
                           "components/saml/test/clojure"
                           "bases/auth-api/test/clojure"
                           "components/schema/test/clojure"
                           "components/config/test/clojure"]}

  :poly {:main-opts ["-m" "polylith.clj.core.poly-cli.core"]
         :extra-deps {polylith/clj-poly {:mvn/version "0.3.32"}
                      io.github.seancorfield/polylith-external-test-runner
                      {:git/tag "v0.8.0" :git/sha "2ad770c"
                       :deps/root "projects/runner"}}}

  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.0"}}
          :paths []
          :ns-default build
          ;; JNA is on the classpath during compilation too, causing the same
          ;; native-access warnings in the build JVM. Remove alongside :dev when
          ;; JNA updates.
          :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}}}