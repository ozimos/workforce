{:mvn/repos {"central" {:url "https://repo1.maven.org/maven2/"}
             "clojars" {:url "https://clojars.org/repo/"}
             "rpl"     {:url "https://nexus.redplanetlabs.com/repository/maven-public-releases/"}}

 :aliases
 {:dev {:extra-paths ["components/frontend/src/clj" "components/frontend/src/cljs" "components/frontend/test/cljs"]
        :extra-deps {org.clojure/clojure {:mvn/version "1.12.4"}
                     hato/hato {:mvn/version "1.0.0"}
                     metosin/jsonista {:mvn/version "0.3.14"}

                     ;; Dev tools
                     integrant/integrant      {:mvn/version "1.0.0"}
                     integrant/repl           {:mvn/version "0.4.0"}
                     nrepl/nrepl              {:mvn/version "1.3.0"}
                     io.github.tonsky/clj-reload {:mvn/version "1.0.0"}

                     ;; Frontend (shadow-cljs compilation)
                     thheller/shadow-cljs     {:mvn/version "3.4.11"}
                     com.fulcrologic/fulcro   {:mvn/version "3.9.5"}
                     no.cjohansen/replicant   {:mvn/version "2026.07.1"}}
        ;; JNA (transitive dep, likely via Rama) calls
        ;; java.lang.System::load on Java 25+. Suppresses
        ;; restricted-method warnings for unnamed modules.
        ;; Remove when JNA ships a version using the FFM API.
        :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}

  :test {:extra-paths ["components/org-rama/test/clojure"
                       "bases/web/test/clojure"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                      hato/hato {:mvn/version "1.0.0"}
                      metosin/jsonista {:mvn/version "0.3.14"}}}

  :+rama {:extra-deps {poly/org-rama {:local/root "components/org-rama"}}
          :extra-paths ["components/org-rama/test/clojure"]}

  :+default {:extra-deps {com.ozimos.omni-auth/schema          {:local/root "../../omni-auth/main/components/schema"}
                          com.ozimos.omni-auth/config          {:local/root "../../omni-auth/main/components/config"}
                          com.ozimos.omni-auth/rama            {:local/root "../../omni-auth/main/components/rama"}
                          com.ozimos.omni-auth/user-rama       {:local/root "../../omni-auth/main/components/user-rama"}
                          com.ozimos.omni-auth/session-rama    {:local/root "../../omni-auth/main/components/session-rama"}
                          com.ozimos.omni-auth/revocation-rama {:local/root "../../omni-auth/main/components/revocation-rama"}
                          com.ozimos.omni-auth/token           {:local/root "../../omni-auth/main/components/token"}
                          com.ozimos.omni-auth/security        {:local/root "../../omni-auth/main/components/security"}
                          com.ozimos.omni-auth/pathom          {:local/root "../../omni-auth/main/components/pathom"}
                          com.ozimos.omni-auth/mfa             {:local/root "../../omni-auth/main/components/mfa"}
                          com.ozimos.omni-auth/webauthn        {:local/root "../../omni-auth/main/components/webauthn"}
                          com.ozimos.omni-auth/oauth           {:local/root "../../omni-auth/main/components/oauth"}
                          com.ozimos.omni-auth/saml            {:local/root "../../omni-auth/main/components/saml"}
                          poly/org-rama        {:local/root "components/org-rama"}
                          poly/web             {:local/root "bases/web"}}
             :extra-paths ["development/src/clojure" "development/resources"
                           "components/org-rama/test/clojure"
                           "bases/web/test/clojure"]}

  :poly {:main-opts ["-m" "polylith.clj.core.poly-cli.core"]
         :extra-deps {polylith/clj-poly {:mvn/version "0.3.32"}
                      io.github.seancorfield/polylith-external-test-runner
                      {:git/tag "v0.8.0" :git/sha "2ad770c"
                       :deps/root "projects/runner"}}}

  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.0"}}
          :paths []
          :ns-default build
          ;; JNA is on the classpath during compilation too, causing the same
          ;; native-access warnings in the build JVM. Remove alongside :dev when
          ;; JNA updates.
          :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}}}
