{:top-namespace "com.ozimos.auth"
 :interface-ns "interface"
 :dialects ["clj" "cljs"]
 :compact-views #{}
 :vcs {:name "git"
       :auto-add false}
 :tag-patterns {:stable "^stable-.*"
                :release "^v[0-9].*"}
   :projects {"development" {:alias "devl"}
              "auth-service" {:alias "auth"}}
    :profiles {:default {:names ["schema" "config" "rama" "user-rama" "session-rama"
                                 "revocation-rama" "token" "security" "pathom"
                                 "frontend" "auth-api"]}}
   :test {:setup-fn "com.ozimos.auth.auth-api.test-system/setup"
          :teardown-fn "com.ozimos.auth.auth-api.test-system/teardown"
          :create-test-runner
          [org.corfield.external-test-runner.interface/create]}}