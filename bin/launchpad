#!/usr/bin/env bb
(require '[lambdaisland.launchpad :as lp]
         '[lambdaisland.launchpad.log :as log]
         '[babashka.wait :as wait]
         '[clojure.java.shell :as shell]
         '[clojure.string :as str]
         '[clojure.java.io :as io])

(import '[java.lang ProcessBuilder ProcessBuilder$Redirect])

(defn ensure-java-min-version
  "Ensure the JVM major version is >= min-version."
  [min-version ctx]
  (let [version (parse-long (last (re-find #"version \"([^\.\"]*)"
                                            (-> (shell/sh "java" "-version")
                                                :err
                                                (str/split #"\n")
                                                first))))]
    (log/debug "Found java" version)
    (when (< version min-version)
      (log/error "Found java" version ", expected Java >=" min-version)
      (System/exit -1))
    ctx))

(defn- read-deps-local
  []
  (let [f (io/file "deps.local.edn")]
    (when (.exists f)
      (try (read-string (slurp f))
           (catch Exception _ nil)))))

;; ---------------------------------------------------------------------------
;; Per-worktree log file
;; ---------------------------------------------------------------------------
;; Every worktree runs its own launchpad and they are frequently up at the same
;; time. A single shared log path means concurrent sessions write at independent
;; file offsets and interleave half-written lines, so each worktree gets a
;; private log under .launchpad/ (covered by the existing `*.log` gitignore
;; rule). Override with $LAUNCHPAD_LOG_FILE or
;; deps.local.edn {:launchpad {:log-file "..."}}; an empty string disables
;; logging and runs launchpad in the foreground.

(def default-log-file ".launchpad/bb-repl.log")

(defn log-file-path
  "Where this worktree's launchpad log is written, or nil to disable logging."
  []
  (let [from-env   (System/getenv "LAUNCHPAD_LOG_FILE")
        from-local (get-in (read-deps-local) [:launchpad :log-file])]
    (cond
      (and from-env (empty? (str/trim from-env))) nil
      (seq from-env)                             (str/trim from-env)
      from-local                                 from-local
      :else                                      default-log-file)))

(defn- log-banner
  "Header written at the top of every run so an appended log stays readable."
  []
  (str "\n=== launchpad start " (java.time.LocalDateTime/now) " ===\n"
       "    worktree: " (.getCanonicalPath (io/file ".")) "\n"
       "    args:     " (str/join " " *command-line-args*) "\n"))

(defn- tee-and-run!
  "Re-run this script with stdout and stderr piped through `tee` into `path`.

   The redirection has to happen at the file-descriptor level: launchpad also
   spawns Mailpit, the JVM, shadow-cljs and the SSR server, and child processes
   inherit fd 1/2 rather than any stream Clojure could wrap. `startPipeline`
   wires the child's stdout into tee's stdin without a shell in the picture, so
   argument quoting cannot go wrong and the child still writes to the terminal.

   Blocks until the pipeline drains and returns the launchpad exit code."
  [path]
  (let [cmd          (into ["bb" (or *file* "bin/launchpad")] *command-line-args*)
        child-pb     (let [pb (ProcessBuilder. ^java.util.List (vec cmd))]
                       ;; Merge stderr into the same pipe so the log is complete.
                       (.redirectErrorStream pb true)
                       (.put (.environment pb) "LAUNCHPAD_LOG_ACTIVE" "1")
                       pb)
        tee-pb       (doto (ProcessBuilder. ^java.util.List ["tee" "-a" path])
                       (.redirectOutput ProcessBuilder$Redirect/INHERIT))
        procs        (ProcessBuilder/startPipeline [child-pb tee-pb])
        child        (first procs)]
    ;; If this wrapper is signalled, take the child with it rather than leaving
    ;; an orphaned launchpad holding every dev port.
    (.addShutdownHook (Runtime/getRuntime)
                      (Thread. (fn [] (doseq [p procs]
                                        (try (.destroy p) (catch Exception _ nil))))))
    (let [exit (.waitFor child)]
      (doseq [p (rest procs)] (.waitFor p))
      exit)))

(when-not (= "1" (System/getenv "LAUNCHPAD_LOG_ACTIVE"))
  (let [path (log-file-path)]
    ;; Without tee we simply run in the foreground rather than losing output.
    (when (and path (zero? (:exit (shell/sh "which" "tee"))))
      (io/make-parents path)
      (let [banner (log-banner)]
        (spit path banner :append true)
        (print banner)
        (flush))
      (System/exit (tee-and-run! path)))))

(defn install-node-deps
  "Run `pnpm install` before anything attempts a shadow-cljs build.

   Launchpad itself has no package-manager install option (v0.53.238-alpha only
   reads generic :launchpad/options into its context), so this is an explicit
   project pre-step. pnpm's frozen lockfile and content-addressed store make the
   already-up-to-date case cheap, while still repairing a partial node_modules
   in a freshly created worktree.

   Disable with deps.local.edn {:node/install {:enabled false}}."
  [ctx]
  (let [local    (read-deps-local)
        enabled? (get-in local [:node/install :enabled] true)
        package  (io/file "package.json")
        pnpm?    (zero? (:exit (shell/sh "which" "pnpm")))]
    (cond
      (not enabled?) ctx
      (not (.exists package)) ctx
      (not pnpm?)
      (do (log/error "package.json exists but pnpm is not available on PATH")
          (System/exit 1))
      :else
      (do (log/info "Ensuring JavaScript dependencies are installed (pnpm install --frozen-lockfile)...")
          (let [{:keys [exit out err]} (shell/sh "pnpm" "install" "--frozen-lockfile")]
            (when (seq out) (print out))
            (when (seq err) (binding [*out* *err*] (print err)))
            (flush)
            (when-not (zero? exit)
              (log/error "pnpm install failed; aborting launchpad startup")
              (System/exit exit)))
          ctx))))

(defn resolve-nrepl-port
  "If :launchpad/options :nrepl-port is 0 or nil, allocate a free port at boot."
  [ctx]
  (let [local (read-deps-local)
        configured (get-in local [:launchpad/options :nrepl-port])]
    (if (or (nil? configured) (not (and (integer? configured) (pos? configured))))
      (let [port (lp/free-port)]
        (log/info "Dynamically resolved nREPL port:" port)
        (assoc ctx :nrepl-port port))
      ctx)))

(defn resolve-jetty-ports
  "Reads :jetty/port from deps.local.edn and injects JETTY_DEV_PORT,
   JETTY_TEST_PORT, JETTY_PROD_PORT into the child process environment.

   :jetty/port is a map with :dev, :test, :prod subkeys. Each value is
   either a positive integer (fixed port) or 0/nil (pick a random free port).
   When :jetty/port is absent entirely, no env vars are set and Aero
   falls back to each profile's default."
  [ctx]
  (let [local-file (io/file "deps.local.edn")
        jetty-cfg  (when (.exists local-file)
                     (:jetty/port (read-string (slurp local-file))))]
    (if jetty-cfg
      (let [profiles  [:dev :test :prod]
            env-names {:dev "JETTY_DEV_PORT" :test "JETTY_TEST_PORT" :prod "JETTY_PROD_PORT"}]
        (reduce (fn [acc profile]
                  (let [val (get jetty-cfg profile)
                        port (if (and (integer? val) (pos? val))
                               val
                               (lp/free-port))]
                    (log/info (str "Resolved " (env-names profile) ":") port)
                    (update acc :env assoc (env-names profile) (str port))))
                ctx
                profiles))
      ctx)))

(defn resolve-shadow-ports
  "Resolve shadow-cljs HTTP and nREPL ports once and store in ctx."
  [ctx]
  (let [local (read-deps-local)
        configured-http  (or (get-in local [:launchpad/options :shadow-cljs-http-port])
                             (get-in local [:shadow-cljs :http-port]))
        http-p (if (or (nil? configured-http) (not (and (integer? configured-http) (pos? configured-http))))
                 (if (contains? (or local {}) :shadow-cljs)
                   (lp/free-port)
                   9630)
                 configured-http)
        configured-nrepl (get-in local [:shadow-cljs :nrepl-port])
        nrepl-p (if (and (integer? configured-nrepl) (pos? configured-nrepl))
                  configured-nrepl
                  (lp/free-port))]
    (assoc ctx
           :shadow-cljs-http-port http-p
           :shadow-cljs-nrepl-port nrepl-p)))

(defn shadow-cljs-http-port
  "Resolve the shadow-cljs HTTP server port."
  ([] (shadow-cljs-http-port {}))
  ([ctx]
   (or (:shadow-cljs-http-port ctx)
       (let [local (read-deps-local)
             p (or (get-in local [:launchpad/options :shadow-cljs-http-port])
                   (get-in local [:shadow-cljs :http-port]))]
         (if (or (nil? p) (not (and (integer? p) (pos? p))))
           (if (contains? (or local {}) :shadow-cljs)
             (lp/free-port)
             9630)
           p)))))

(defn shadow-cljs-nrepl-port
  "Resolve the shadow-cljs nREPL server port."
  ([] (shadow-cljs-nrepl-port {}))
  ([ctx]
   (or (:shadow-cljs-nrepl-port ctx)
       (let [local (read-deps-local)
             p (get-in local [:shadow-cljs :nrepl-port])]
         (if (and (integer? p) (pos? p))
           p
           (lp/free-port))))))

(defn start-frontend-watcher
  "If deps.local.edn has :frontend/watcher :enabled, add eval forms
   to start shadow-cljs watch inside the JVM at startup with isolated ports."
  [ctx]
  (let [local-file (io/file "deps.local.edn")]
    (if (and (.exists local-file)
             (get-in (read-string (slurp local-file)) [:frontend/watcher :enabled]))
      (let [http-p  (shadow-cljs-http-port ctx)
            nrepl-p (shadow-cljs-nrepl-port ctx)]
        (log/info (str "Starting shadow-cljs frontend watcher (HTTP port: " http-p ", nREPL port: " nrepl-p ")..."))
        (-> ctx
            (update :eval-forms into
                    [`(do (require 'shadow.cljs.devtools.server)
                          (require 'shadow.cljs.devtools.api)
                          (require 'shadow.cljs.devtools.config)
                          (let [base-cfg# (shadow.cljs.devtools.config/load-cljs-edn)
                                cfg# (assoc base-cfg#
                                       :http {:port ~http-p}
                                       :nrepl {:port ~nrepl-p})]
                            (shadow.cljs.devtools.server/start! cfg#)))
                     '(shadow.cljs.devtools.api/watch :app)
                     '(shadow.cljs.devtools.api/watch :ssr)])))
      ctx)))

(defn resolve-ssr-port
  "Resolve SSR server port. Checked in order:
   - SSR_PORT environment variable
   - deps.local.edn (:ssr-server :port, :ssr/port, :ssr-port)
   - default 3000"
  ([] (resolve-ssr-port (read-deps-local)))
  ([local]
   (or (when-let [p (System/getenv "SSR_PORT")]
         (try (parse-long p) (catch Exception _ nil)))
       (when local
         (or (get-in local [:ssr-server :port])
             (get local :ssr/port)
             (get local :ssr-port)))
       3000)))

(defn find-pids-on-port
  "Find PIDs of processes listening on the given TCP port."
  [port]
  (try
    (let [res (shell/sh "lsof" "-ti" (str "tcp:" port) "-sTCP:LISTEN")]
      (when (zero? (:exit res))
        (->> (str/split-lines (:out res))
             (map str/trim)
             (filter seq)
             (map parse-long)
             (filter some?))))
    (catch Exception _ nil)))

(defn kill-port!
  "Kill any process listening on the given TCP port."
  [port]
  (when-let [pids (seq (find-pids-on-port port))]
    (log/info (str "Terminating stale process(es) on port " port " (PID: " (str/join ", " pids) ")..."))
    (doseq [pid pids]
      (try (shell/sh "kill" "-15" (str pid))
           (catch Exception _ nil)))
    (Thread/sleep 300)
    (when-let [remaining (seq (find-pids-on-port port))]
      (doseq [pid remaining]
        (try (shell/sh "kill" "-9" (str pid))
             (catch Exception _ nil)))
      (Thread/sleep 200))))

(defn resolve-mailpit-ports
  "Resolve Mailpit SMTP and HTTP UI ports from deps.local.edn or environment."
  ([] (resolve-mailpit-ports (read-deps-local)))
  ([local]
   (let [smtp-p (or (when-let [p (System/getenv "MAILPIT_SMTP_PORT")] (try (parse-long p) (catch Exception _ nil)))
                    (get-in local [:mailpit :smtp-port])
                    1025)
         http-p (or (when-let [p (System/getenv "MAILPIT_HTTP_PORT")] (try (parse-long p) (catch Exception _ nil)))
                    (get-in local [:mailpit :http-port])
                    8025)]
     {:smtp-port smtp-p :http-port http-p})))

(defn mailpit-http-ok?
  "Does something answer an HTTP GET on `http-port`?

   A raw socket is used rather than curl so the probe cannot be diverted by an
   HTTP proxy configured in the environment."
  [http-port]
  (try
    (with-open [sock (java.net.Socket.)]
      (.connect sock (java.net.InetSocketAddress. "127.0.0.1" http-port) 1500)
      (.setSoTimeout sock 1500)
      (let [w (java.io.PrintWriter. (java.io.OutputStreamWriter. (.getOutputStream sock) "UTF-8") true)]
        (.print w "GET / HTTP/1.0\r\nHost: localhost\r\n\r\n")
        (.flush w))
      (let [rdr  (java.io.BufferedReader. (java.io.InputStreamReader. (.getInputStream sock) "UTF-8"))
            head (str (.readLine rdr))]
        (boolean (re-find #"^HTTP/\S+\s+[23]\d\d" head))))
    (catch Exception _ false)))

(defn mailpit-running?
  "Is a Mailpit already up on the configured ports?

   The HTTP UI answering is the primary signal. The fallback requires *both*
   ports to be held, so an unrelated process squatting on one of them is not
   mistaken for Mailpit — that would silently leave the dev environment with no
   mail sink at all."
  [{:keys [smtp-port http-port]}]
  (boolean
   (or (mailpit-http-ok? http-port)
       (and (seq (find-pids-on-port smtp-port))
            (seq (find-pids-on-port http-port))))))

(defn register-shutdown-cleanup!
  "Add JVM/Babashka shutdown hook to terminate any process listening on SSR and
   shadow ports when launchpad exits.

   Mailpit is deliberately absent: it is a shared, machine-wide resource, so
   tearing it down here would kill a sibling worktree's mail sink."
  [ctx]
  (let [local (read-deps-local)
        ssr-port (resolve-ssr-port local)
        shadow-port (shadow-cljs-http-port)]
    (.addShutdownHook
      (Runtime/getRuntime)
      (Thread.
        (fn []
          (when ssr-port (kill-port! ssr-port))
          (when shadow-port (kill-port! shadow-port))))))
  ctx)

(defn cleanup-stale-dev-ports
  "Clean up stale listeners on configured dev ports (nREPL, shadow-cljs, SSR, Jetty) before boot.

   Mailpit is deliberately excluded — it is shared across worktrees."
  [ctx]
  (let [local (read-deps-local)
        nrepl-p (get-in local [:launchpad/options :nrepl-port])
        shadow-p (shadow-cljs-http-port)
        ssr-p (resolve-ssr-port local)
        jetty-dev-p (get-in local [:jetty/port :dev])]
    (when (and (integer? nrepl-p) (pos? nrepl-p))
      (kill-port! nrepl-p))
    (when (and (integer? shadow-p) (pos? shadow-p))
      (kill-port! shadow-p)
      (kill-port! (inc shadow-p)))
    (when (and (integer? ssr-p) (pos? ssr-p))
      (kill-port! ssr-p))
    (when (and (integer? jetty-dev-p) (pos? jetty-dev-p))
      (kill-port! jetty-dev-p))
    ctx))

(defn start-mailpit
  "If the mailpit binary is on PATH, start Mailpit in the background — unless one is already running.

   Mailpit is a shared, machine-wide resource: several worktrees run their own
   launchpad concurrently and all of them deliver mail to the same Mailpit. So
   the ports are never freed here (that would kill a sibling worktree's mail
   sink); we only detect an existing instance and, when there is one, adopt it
   instead of starting a second."
  [ctx]
  (let [local (read-deps-local)
        enabled? (get-in local [:mailpit :enabled] true)
        ports (resolve-mailpit-ports local)
        {:keys [smtp-port http-port]} ports]
    (if-not (and enabled? (zero? (:exit (shell/sh "which" "mailpit"))))
      ctx
      (if (mailpit-running? ports)
        (do (log/info (str "Mailpit already running (SMTP :" smtp-port ", HTTP UI :" http-port
                           "); reusing the shared instance."))
            ctx)
        (do (log/info (str "Starting Mailpit (SMTP :" smtp-port ", HTTP UI :" http-port ")..."))
            ((lambdaisland.launchpad/run-process
              {:cmd         ["mailpit" "--smtp" (str "[::]:" smtp-port) "--listen" (str "[::]:" http-port)]
               :background? true
               :prefix      "mailpit"})
             ctx))))))

(defn start-ssr-server
  "If deps.local.edn has :ssr-server :enabled, spawn the Node SSR server
   (ssr-server/server.js) as a launchpad-managed background process so it
   is started/stopped alongside the Clojure REPL and shadow watches."
  [ctx]
  (let [local-file (io/file "deps.local.edn")
        ssr-dir    (io/file "ssr-server")]
    (if (and (.exists local-file)
             (.exists ssr-dir)
             (get-in (read-string (slurp local-file)) [:ssr-server :enabled]))
      (let [local      (read-deps-local)
            ssr-port   (resolve-ssr-port local)
            jetty-port (or (get-in ctx [:env "JETTY_DEV_PORT"])
                           (get-in local [:jetty/port :dev])
                           "8080")
            api-target (str "http://localhost:" jetty-port)]
        ;; Ensure any stale process on the SSR port is killed before spawning
        (kill-port! ssr-port)
        (log/info (str "Starting Node SSR server on port " ssr-port " (ssr-server/server.js)..."))
        ((lambdaisland.launchpad/run-process
          {:cmd         ["node" "server.js"]
           :working-dir "ssr-server"
           :env         (assoc (:env ctx)
                               "API_TARGET" api-target
                               "JETTY_DEV_PORT" (str jetty-port)
                               "SSR_PORT" (str ssr-port)
                               "NODE_PATH" (str (.getAbsolutePath (io/file "ssr-server" "node_modules"))))
           :background? true
           :prefix      "ssr-server"})
         ctx))
      ctx)))

(defn wait-for-shadow-cljs
  "Block until the shadow-cljs HTTP server is accepting TCP connections.

   Must run AFTER lp/default-steps (which spawns the JVM via
   start-clojure-process and waits for nREPL). By the time nREPL is up,
   shadow-cljs's HTTP server has also started — this step re-confirms
   that the port is listening so the SSR server's relay client doesn't
   race the JVM at boot."
  [ctx]
  (let [port    (shadow-cljs-http-port ctx)
        timeout 300000]
    (log/info "Waiting for shadow-cljs HTTP server on port" port "...")
    (if-let [{:keys [took]} (wait/wait-for-port "localhost" port {:timeout timeout :pause 1000})]
      (do (log/info "shadow-cljs HTTP server reachable after" (/ took 1000.0) "seconds")
          (Thread/sleep 1000)
          ctx)
      (do (log/warn "shadow-cljs HTTP server not reachable on port" port
                    "after" (/ timeout 1000) "seconds; starting SSR server anyway")
          ctx))))

(defn auto-start-system
  "If deps.local.edn has :system/auto-start true (or defaults to true),
   add eval forms to automatically run (user/go) or (user/start-and-seed!) on JVM startup."
  [ctx]
  (let [local (read-deps-local)
        auto-start? (get local :system/auto-start true)
        auto-seed?  (get local :system/auto-seed true)]
    (if auto-start?
      (if auto-seed?
        (do (log/info "Configuring automatic system startup & seeding (user/start-and-seed!)...")
            (update ctx :eval-forms conj '(do (in-ns 'user) (start-and-seed!))))
        (do (log/info "Configuring automatic system startup (user/go)...")
            (update ctx :eval-forms conj '(do (in-ns 'user) (go)))))
      ctx)))

(lp/main
 {:steps
  (into [(partial ensure-java-min-version 21)
         install-node-deps
         cleanup-stale-dev-ports
         resolve-nrepl-port
         resolve-shadow-ports
         register-shutdown-cleanup!
         start-mailpit
         start-frontend-watcher
         auto-start-system
         resolve-jetty-ports]
        (concat lp/default-steps
                [wait-for-shadow-cljs
                 start-ssr-server]))})
