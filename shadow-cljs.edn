{:source-paths ["components/frontend-ui/src/cljc"
                "components/frontend-ui/test/cljc"
                "components/frontend-web/src/cljs"
                "components/frontend-web/test/cljs"]
 :dependencies [[no.cjohansen/replicant "2026.07.1"]]
 :builds {:app {:target :browser
                :output-dir "bases/web/resources/public/js"
                :compiler {:preloads [shadow.cljs.devtools.client.browser]}
                :devtools {:after-load com.ozimos.workforce.frontend.web.core/refresh}
                :init-fn com.ozimos.workforce.frontend.web.core/init
                :modules {:main {:entries [com.ozimos.workforce.frontend.web.core]}}}
          :ssr {:target :node-library
                :output-to "ssr-output/ssr.js"
                :exports {:render-page-html com.ozimos.workforce.frontend.web.ssr/render-page-html}
                :compiler {:external-json-modules? true}
                :modules {:ssr {:entries [com.ozimos.workforce.frontend.web.ssr]}}}
          :test {:target :node-test
                 :output-to "target/frontend-test.js"
                 :main com.ozimos.workforce.frontend.web.test-runner/main
                 :autorun true}}}
