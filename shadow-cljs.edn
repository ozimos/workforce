{:source-paths ["components/frontend/src/cljs" "components/frontend/test/cljs"]
 :dependencies [[com.fulcrologic/fulcro "3.9.5"]]
 :builds {:app {:target :browser
                :output-dir "bases/web/resources/public/js"
                :compiler {:preloads [shadow.cljs.devtools.client.browser
                     com.fulcrologic.fulcro.inspect.preload]}
                :devtools {:after-load com.ozimos.workforce.frontend.core/refresh}
                :init-fn com.ozimos.workforce.frontend.core/init
                :modules {:main {:entries [com.ozimos.workforce.frontend.core]}}}
          :ssr {:target :node-library
                :output-to "ssr-output/ssr.js"
                :exports {:render-page-html com.ozimos.workforce.frontend.ssr/render-page-html}
                :compiler {:external-json-modules? true}
                :modules {:ssr {:entries [com.ozimos.workforce.frontend.ssr]}}}
          :test {:target :node-test
                 :output-to "target/frontend-test.js"
                 :main com.ozimos.workforce.frontend.test-runner/main
                 :autorun true}}}
