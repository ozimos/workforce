{:deps
 {com.lambdaisland/launchpad {:mvn/version "0.53.238-alpha"}}

 :tasks
 {:requires ([babashka.process :as p :refer [shell process destroy-tree]]
             [babashka.fs :as fs]
             [clojure.string :as str]
             [clojure.pprint :refer [pprint]])

  :init
  (do
    (defn resolve-nrepl-port []
      (or (try (parse-long (str/trim (slurp ".nrepl-port"))) (catch Exception _ nil))
          (try (parse-long (str/trim (slurp ".shadow-cljs/nrepl.port"))) (catch Exception _ nil))
          (try (let [local (read-string (slurp "deps.local.edn"))
                     p (get-in local [:launchpad/options :nrepl-port])]
                 (when (and (integer? p) (pos? p)) p))
               (catch Exception _ nil))
          4005))

    (defn wait-for-port [port timeout-ms]
      (let [deadline (+ (System/currentTimeMillis) timeout-ms)]
        (loop []
          (if (try (let [s (java.net.Socket. "localhost" port)]
                     (.close s)
                     true)
                   (catch Exception _ false))
            true
            (when (< (System/currentTimeMillis) deadline)
              (Thread/sleep 250)
              (recur))))))

    (defn resolve-ssr-port []
      (let [local (try (read-string (slurp "deps.local.edn")) (catch Exception _ nil))]
        (or (when-let [p (System/getenv "SSR_PORT")]
              (try (parse-long p) (catch Exception _ nil)))
            (when local
              (or (get-in local [:ssr-server :port])
                  (get local :ssr/port)
                  (get local :ssr-port)))
            3000)))

    (defn kill-ssr-port! []
      (let [port (resolve-ssr-port)
            res (p/shell {:out :string :err :string :continue true}
                         "lsof" "-ti" (str "tcp:" port) "-sTCP:LISTEN")
            pids (->> (str/split-lines (:out res))
                      (map str/trim)
                      (filter seq))]
        (if (seq pids)
          (do (println (str "Terminating process(es) listening on SSR port " port " (PID: " (str/join ", " pids) ")..."))
              (doseq [pid pids]
                (p/shell {:continue true} "kill" "-15" pid))
              (Thread/sleep 300)
              (let [res2 (p/shell {:out :string :continue true} "lsof" "-ti" (str "tcp:" port) "-sTCP:LISTEN")
                    rem (->> (str/split-lines (:out res2)) (map str/trim) (filter seq))]
                (when (seq rem)
                  (doseq [pid rem]
                    (p/shell {:continue true} "kill" "-9" pid))))
              (println (str "SSR port " port " is now free.")))
          (println (str "No active process found listening on SSR port " port ".")))))

    (defn run-jvm-tests [args]
      (let [cmd-args (or (seq args) ["test" "project:auth-service"])]
        (shell "clojure" "-X:deps" "prep" ":aliases" "[:dev :test :+rama :+default :poly]")
        (apply shell "clojure" "-M:dev:test:+rama:+default:poly" cmd-args)))

    (defn run-in-repl-or-fallback [repl-expr-fn args]
      (let [port (resolve-nrepl-port)]
        (if (wait-for-port port 1500)
          (repl-expr-fn port args)
          (do (println "\n=== REPL not detected, falling back to standalone JVM test runner ===")
              (run-jvm-tests args))))))

  lint         (shell {:continue true} "clj-kondo" "--lint" "bases" "components" "projects" "development/src/clojure" "bin/launchpad")
  kondo-copy-configs (let [cp (str/trim (:out (p/shell {:out :string} "clojure" "-Spath" "-A:+default:dev")))]
                       (shell {:continue true} "clj-kondo" "--copy-configs" "--lint" cp "--skip-warnings"))
  fmt-check    (shell {:continue true} "standard-clj" "check" "bases" "components" "projects" "development/src/clojure")
  fmt-fix      (shell {:continue true} "standard-clj" "fix" "bases" "components" "projects" "development/src/clojure")
  ssr-kill     {:doc "Detect SSR port (from env SSR_PORT, deps.local.edn, or 3000) and kill listening process."
                :task (kill-ssr-port!)}
  kill-ssr     {:doc "Alias for ssr-kill."
                :task (kill-ssr-port!)}
  repl         {:override-builtin true
                :task (let [args (or (seq *command-line-args*) ["+default" "dev" "+rama" "test"])]
                        (kill-ssr-port!)
                        (apply shell "bin/launchpad" args))}
  test         (run-jvm-tests *command-line-args*)
  test-fast    (run-in-repl-or-fallback
                (fn [port args]
                  (println (str "\n=== Running Backend Tests in Dev REPL (port " port ") ==="))
                  (if (seq args)
                    (doseq [ns-str args]
                      (shell "clj-nrepl-eval" "-p" (str port)
                             (str "((ns-resolve 'user 'test-ns) '" ns-str ")")))
                    (shell "clj-nrepl-eval" "-p" (str port)
                           "((ns-resolve 'user 'test-all))")))
                *command-line-args*)
  test-fast-clean
               (run-in-repl-or-fallback
                (fn [port _]
                  (println (str "\n=== Running Clean Backend Tests in Dev REPL (port " port ") ==="))
                  (shell "clj-nrepl-eval" "-p" (str port)
                         "((ns-resolve 'user 'test-clean))"))
                *command-line-args*)
  test-repl-boot
               (do
                 (println "\n=== [CI] 1/4 Starting fresh background dev REPL ===")
                 (let [repl-proc (p/process ["bin/launchpad" "+default" "dev" "+rama" "test"]
                                            {:out :inherit :err :inherit :dir "."})]
                   (try
                     (let [port (resolve-nrepl-port)]
                       (println (str "=== [CI] 2/4 Waiting up to 60s for nREPL on port " port " ==="))
                       (if-not (wait-for-port port 60000)
                         (do (println "ERROR: nREPL server did not start within 60s")
                             (System/exit 1))
                         (println (str "=== [CI] nREPL is live on port " port " ===")))

                       (println "\n=== [CI] 3/4 Executing (test-clean) in REPL ===")
                       (let [eval-res (p/shell {:continue true :out :string :err :string}
                                               "clj-nrepl-eval" "-p" (str port)
                                               "((ns-resolve 'user 'test-clean))")]
                         (println (:out eval-res))
                         (if (and (zero? (:exit eval-res))
                                  (str/includes? (:out eval-res) ":fail 0, :error 0"))
                           (println "\n=== [CI] 4/4 REPL Boot & In-REPL Test Suite PASSED ===")
                           (do (println "ERROR: In-REPL test suite failed or encountered errors")
                               (println (:err eval-res))
                               (System/exit 1)))))
                     (finally
                       (println "\n=== [CI] Terminating background dev REPL ===")
                       (p/destroy-tree repl-proc)))))
  test-all     (do (println "\n=== 1/3 Running Clojure JVM Backend Tests ===")
                   (run-jvm-tests *command-line-args*)
                   (println "\n=== 2/3 Running Frontend CLJS Tests ===")
                   (shell "bb" "fe-test")
                   (println "\n=== 3/3 Running Node SSR Proxy Test ===")
                   (shell "node" "ssr-server/test_proxy.js")
                   (println "\n=== ALL TEST SUITES PASSED ==="))
  wt-new       (let [[branch target-dir] *command-line-args*]
                 (if-not branch
                   (println "Usage: bb wt-new <branch-name> [target-dir]")
                   (let [target (or target-dir (str "../" branch))]
                     (shell "git" "worktree" "add" target branch))))
  css          (shell "pnpm" "exec" "tailwindcss" "-i" "components/frontend/src/css/tailwind.css" "-o" "bases/web/resources/public/css/app.css")
  css-watch    (shell "pnpm" "exec" "tailwindcss" "-i" "components/frontend/src/css/tailwind.css" "-o" "bases/web/resources/public/css/app.css" "--watch")
  fe           (shell "pnpm" "exec" "shadow-cljs" "compile" "app")
  fe-watch     (shell "pnpm" "exec" "shadow-cljs" "watch" "app")
  fe-ssr       (shell "pnpm" "exec" "shadow-cljs" "compile" "ssr")
  fe-ssr-watch (shell "pnpm" "exec" "shadow-cljs" "watch" "ssr")
  fe-test      (do (shell "pnpm" "exec" "shadow-cljs" "release" "test")
                   (shell "node" "target/frontend-test.js"))
  ssr-dev      (do (shell "pnpm" "exec" "shadow-cljs" "watch" "ssr")
                   (shell "node" "ssr-server/server.js"))
  ssr-start    (shell "node" "ssr-server/server.js")
  build        (do (css)
                   (shell "pnpm" "exec" "shadow-cljs" "compile" "app")
                   (shell "pnpm" "exec" "shadow-cljs" "compile" "ssr"))}}
