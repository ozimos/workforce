{:deps
 {com.lambdaisland/launchpad {:mvn/version "0.53.238-alpha"}}

 :tasks
 {:requires ([babashka.process :refer [shell]])
  lint         (shell {:continue true} "clj-kondo" "--lint" "bases" "components" "projects" "development/src/clojure")
  fmt-check    (shell {:continue true} "standard-clj" "check" "bases" "components" "projects" "development/src/clojure")
  fmt-fix      (shell {:continue true} "standard-clj" "fix" "bases" "components" "projects" "development/src/clojure")
   repl         {:override-builtin true
                  :task (let [args (or (seq *command-line-args*) ["dev" "+rama"])]
                          (apply shell "bin/launchpad" args))}
    test         (let [args (or (seq *command-line-args*) ["test" "project:auth-service"])]
                   (shell "clojure" "-X:deps" "prep" ":aliases" "[:dev :test :+rama :+default :poly]")
                   (apply shell "clojure" "-M:dev:test:+rama:+default:poly" args))
   css          (shell "npx" "tailwindcss" "-i" "components/frontend/src/css/tailwind.css" "-o" "bases/auth-api/resources/public/css/app.css")
   css-watch    (shell "npx" "tailwindcss" "-i" "components/frontend/src/css/tailwind.css" "-o" "bases/auth-api/resources/public/css/app.css" "--watch")
   fe           (shell "npx" "shadow-cljs" "compile" "app")
   fe-watch     (shell "npx" "shadow-cljs" "watch" "app")
   build        (do (shell "npx" "tailwindcss" "-i" "components/frontend/src/css/tailwind.css" "-o" "bases/auth-api/resources/public/css/app.css")
                    (shell "npx" "shadow-cljs" "compile" "app"))}}
